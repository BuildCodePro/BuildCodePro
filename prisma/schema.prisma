generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model user_statuses {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  users users[]
}

model auth_log_types {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  auth_logs auth_log[]
}

model file_resource_types {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  files files[]
}

model project_statuses {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  projects projects[]
}

model design_job_statuses {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  design_jobs design_jobs[]
}

model compliance_statuses {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  compliance_reports compliance_reports[]
  compliance_items   compliance_items[]
}

model export_formats {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  exports exports[]
}

model export_statuses {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  exports exports[]
}

model billing_cycles {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user_subscriptions user_subscriptions[]
  invoices           invoices[]
}

model subscription_statuses {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user_subscriptions user_subscriptions[]
}

model invoice_statuses {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  invoices invoices[]
}

model ticket_statuses {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  support_tickets support_tickets[]
}

model ticket_priorities {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  support_tickets support_tickets[]
}

model activity_entity_types {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  activity_logs activity_logs[]
}

model activity_actions {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  activity_logs activity_logs[]
}

model usage_event_types {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  usage_events usage_events[]
}

model ai_providers {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  design_jobs design_jobs[]
}

// ─────────────────────────────────────────────────────────────────────────────
// MODULE 1 — AUTHENTICATION & USER MANAGEMENT
// ─────────────────────────────────────────────────────────────────────────────

model users {
  id                Int       @id @default(autoincrement())
  name              String
  email             String    @unique
  role_id           Int
  status_id         Int       @default(4)
  gender            String?
  number            String?
  password          String
  remember_token    String?
  deleted           Boolean   @default(false)
  created_by        Int?
  lat_long          String?
  postal_code       String?
  address           String?
  city              String?
  country           String?
  image             String?
  state             String?
  birth_date        DateTime? @db.Date
  email_verified_at DateTime?
  last_login        DateTime  @default(now())
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  role            roles                @relation(fields: [role_id], references: [id])
  user_status     user_statuses        @relation(fields: [status_id], references: [id])
  auth_log        auth_log[]
  notifications   notifications[]
  uploaded_files  files[]
  user_sessions   user_sessions[]
  two_factor_auth two_factor_auth?
  projects        projects[]
  design_jobs     design_jobs[]
  exports         exports[]
  subscriptions   user_subscriptions[]
  usage_events    usage_events[]
  activity_logs   activity_logs[]
  support_tickets support_tickets[]
  ticket_replies  ticket_replies[]
  export_emails   export_emails[]

  @@index([role_id])
  @@index([status_id])
  @@index([deleted])
}

model roles {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  deleted     Boolean  @default(false)

  users       users[]
  permissions role_permissions[]
}

model permissions {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  module      String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  roles role_permissions[]
}

model role_permissions {
  id            Int @id @default(autoincrement())
  role_id       Int
  permission_id Int

  role       roles       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission_id])
}

model auth_log {
  id         Int      @id @default(autoincrement())
  user_id    Int
  type_id    Int      @default(1)
  ip_address String?
  user_agent String?
  created_at DateTime @default(now())

  users         users          @relation(fields: [user_id], references: [id])
  auth_log_type auth_log_types @relation(fields: [type_id], references: [id])

  @@index([user_id])
  @@index([created_at])
}

model user_sessions {
  id            Int       @id @default(autoincrement())
  user_id       Int
  refresh_token String    @unique @db.Text
  device_name   String?
  ip_address    String?
  user_agent    String?
  expires_at    DateTime
  revoked_at    DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
}

model two_factor_auth {
  id           Int       @id @default(autoincrement())
  user_id      Int       @unique
  secret       String
  is_enabled   Boolean   @default(false)
  backup_codes String[]  @default([])
  verified_at  DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model notifications {
  id         Int       @id @default(autoincrement())
  user_id    Int
  type       String
  title      String?
  message    String
  metadata   Json?
  is_read    Boolean   @default(false)
  read_at    DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  user users @relation(fields: [user_id], references: [id])

  @@index([user_id, is_read])
}

model files {
  id               Int      @id @default(autoincrement())
  public_id        String   @unique
  url              String
  secure_url       String?
  resource_type_id Int      @default(1)
  folder           String?
  original_name    String?
  mime_type        String?
  size             Int?
  uploaded_by      Int
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  uploader          users               @relation(fields: [uploaded_by], references: [id])
  file_resource_type file_resource_types @relation(fields: [resource_type_id], references: [id])
  project_drawings  project_drawings[]
  exports           exports[]

  @@index([uploaded_by])
  @@index([resource_type_id])
}

// ─────────────────────────────────────────────────────────────────────────────
// REFERENCE DATA — NFPA, MANUFACTURERS, OCCUPANCY, JURISDICTIONS
// ─────────────────────────────────────────────────────────────────────────────

model nfpa_editions {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  nfpa_year   Int
  ibc_year    Int
  ifc_year    Int?
  description String?
  is_default  Boolean  @default(false)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  projects    projects[]
  design_jobs design_jobs[]
}

model manufacturers {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  description String?
  website     String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  projects     projects[]
  design_jobs  design_jobs[]
  bom_items    bom_items[]
  device_types device_types[]
}

model occupancy_types {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  projects projects[]
}

model jurisdictions {
  id         Int      @id @default(autoincrement())
  name       String
  state      String?
  country    String   @default("US")
  ahj_code   String?
  notes      String?  @db.Text
  rules      Json?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  projects projects[]

  @@unique([name, state, country])
  @@index([state])
}

model device_types {
  id              Int      @id @default(autoincrement())
  code            String   @unique
  name            String
  category        String
  description     String?
  manufacturer_id Int?
  model_number    String?
  unit_cost       Decimal? @db.Decimal(12, 2)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  manufacturer      manufacturers?      @relation(fields: [manufacturer_id], references: [id])
  device_placements device_placements[]
  bom_items         bom_items[]

  @@index([category])
}

// ─────────────────────────────────────────────────────────────────────────────
// MODULE 2 — PROJECT MANAGEMENT
// ─────────────────────────────────────────────────────────────────────────────

model projects {
  id                        Int      @id @default(autoincrement())
  user_id                   Int
  name                      String
  slug                      String?
  address                   String?
  city                      String?
  state                     String?
  postal_code               String?
  country                   String?  @default("US")
  jurisdiction_id           Int?
  square_footage            Int?
  floors                    Int?
  occupancy_type_id         Int?
  nfpa_edition_id           Int?
  preferred_manufacturer_id Int?
  has_sprinkler_system      Boolean  @default(false)
  has_elevator              Boolean  @default(false)
  has_duct_detectors        Boolean  @default(false)
  has_voice_evacuation      Boolean  @default(false)
  special_notes             String?  @db.Text
  status_id                 Int      @default(1)
  current_version           Int      @default(1)
  deleted                   Boolean  @default(false)
  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt

  user                   users              @relation(fields: [user_id], references: [id])
  project_status         project_statuses   @relation(fields: [status_id], references: [id])
  jurisdiction           jurisdictions?     @relation(fields: [jurisdiction_id], references: [id])
  occupancy_type         occupancy_types?   @relation(fields: [occupancy_type_id], references: [id])
  nfpa_edition           nfpa_editions?     @relation(fields: [nfpa_edition_id], references: [id])
  preferred_manufacturer manufacturers?     @relation(fields: [preferred_manufacturer_id], references: [id])
  buildings              project_buildings[]
  drawings               project_drawings[]
  versions               project_versions[]
  design_jobs            design_jobs[]
  activity_logs          activity_logs[]
  usage_events           usage_events[]

  @@index([user_id])
  @@index([status_id])
  @@index([deleted])
  @@index([name])
}

model project_buildings {
  id             Int      @id @default(autoincrement())
  project_id     Int
  name           String
  address        String?
  floors         Int?
  square_footage Int?
  sort_order     Int      @default(0)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  project           projects            @relation(fields: [project_id], references: [id], onDelete: Cascade)
  drawings          project_drawings[]
  device_placements device_placements[]

  @@index([project_id])
}

model project_drawings {
  id          Int      @id @default(autoincrement())
  project_id  Int
  file_id     Int
  building_id Int?
  floor_label String?
  version     Int      @default(1)
  sort_order  Int      @default(0)
  notes       String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  project  projects           @relation(fields: [project_id], references: [id], onDelete: Cascade)
  file     files              @relation(fields: [file_id], references: [id])
  building project_buildings? @relation(fields: [building_id], references: [id])

  @@index([project_id])
  @@index([file_id])
}

model project_versions {
  id             Int      @id @default(autoincrement())
  project_id     Int
  version        Int
  snapshot       Json
  change_summary String?
  created_by     Int?
  created_at     DateTime @default(now())

  project projects @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@unique([project_id, version])
  @@index([project_id])
}

model activity_logs {
  id             Int      @id @default(autoincrement())
  user_id        Int?
  project_id     Int?
  entity_type_id Int
  entity_id      Int?
  action_id      Int
  description    String?
  metadata       Json?
  ip_address     String?
  created_at     DateTime @default(now())

  user         users?               @relation(fields: [user_id], references: [id])
  project      projects?            @relation(fields: [project_id], references: [id])
  entity_type  activity_entity_types @relation(fields: [entity_type_id], references: [id])
  action       activity_actions     @relation(fields: [action_id], references: [id])

  @@index([user_id])
  @@index([project_id])
  @@index([entity_type_id, entity_id])
  @@index([created_at])
}

// ─────────────────────────────────────────────────────────────────────────────
// MODULE 3 & 4 & 5 — AI DESIGN, MATERIAL TAKEOFF, COMPLIANCE
// ─────────────────────────────────────────────────────────────────────────────

model design_jobs {
  id               Int       @id @default(autoincrement())
  project_id       Int
  user_id          Int
  version          Int       @default(1)
  status_id        Int       @default(1)
  nfpa_edition_id  Int?
  manufacturer_id  Int?
  ai_provider_id   Int?
  ai_model         String?
  prompt           String?   @db.Text
  raw_response     Json?
  error_message    String?   @db.Text
  confidence_score Decimal?  @db.Decimal(5, 2)
  started_at       DateTime?
  completed_at     DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  project           projects              @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user              users                 @relation(fields: [user_id], references: [id])
  design_job_status design_job_statuses   @relation(fields: [status_id], references: [id])
  nfpa_edition      nfpa_editions?        @relation(fields: [nfpa_edition_id], references: [id])
  manufacturer      manufacturers?        @relation(fields: [manufacturer_id], references: [id])
  ai_provider       ai_providers?         @relation(fields: [ai_provider_id], references: [id])
  design_result     design_results?
  device_placements device_placements[]
  bom_items         bom_items[]
  wiring_estimates  bom_wiring_estimates[]
  compliance_report compliance_reports?
  exports           exports[]
  usage_events      usage_events[]

  @@index([project_id])
  @@index([user_id])
  @@index([status_id])
}

model design_results {
  id              Int      @id @default(autoincrement())
  design_job_id   Int      @unique
  narrative       String?  @db.Text
  summary         String?  @db.Text
  recommendations Json?
  alternatives    Json?
  metadata        Json?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  design_job design_jobs @relation(fields: [design_job_id], references: [id], onDelete: Cascade)
}

model device_placements {
  id             Int      @id @default(autoincrement())
  design_job_id  Int
  building_id    Int?
  device_type_id Int?
  floor_label    String?
  room_label     String?
  x_coordinate   Decimal? @db.Decimal(10, 4)
  y_coordinate   Decimal? @db.Decimal(10, 4)
  quantity       Int      @default(1)
  confidence     Decimal? @db.Decimal(5, 2)
  explanation    String?  @db.Text
  is_alternative Boolean  @default(false)
  metadata       Json?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  design_job  design_jobs        @relation(fields: [design_job_id], references: [id], onDelete: Cascade)
  building    project_buildings? @relation(fields: [building_id], references: [id])
  device_type device_types?      @relation(fields: [device_type_id], references: [id])

  @@index([design_job_id])
  @@index([device_type_id])
}

model bom_items {
  id              Int      @id @default(autoincrement())
  design_job_id   Int
  device_type_id  Int?
  manufacturer_id Int?
  category        String
  item_name       String
  model_number    String?
  description     String?
  quantity        Int      @default(1)
  unit            String   @default("ea")
  unit_cost       Decimal? @db.Decimal(12, 2)
  total_cost      Decimal? @db.Decimal(12, 2)
  sort_order      Int      @default(0)
  metadata        Json?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  design_job   design_jobs    @relation(fields: [design_job_id], references: [id], onDelete: Cascade)
  device_type  device_types?  @relation(fields: [device_type_id], references: [id])
  manufacturer manufacturers? @relation(fields: [manufacturer_id], references: [id])

  @@index([design_job_id])
  @@index([category])
}

model bom_wiring_estimates {
  id                Int      @id @default(autoincrement())
  design_job_id     Int
  wire_type         String
  gauge             String?
  length_ft         Decimal  @db.Decimal(10, 2)
  conduit_type      String?
  conduit_length_ft Decimal? @db.Decimal(10, 2)
  notes             String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  design_job design_jobs @relation(fields: [design_job_id], references: [id], onDelete: Cascade)

  @@index([design_job_id])
}

model compliance_reports {
  id                 Int      @id @default(autoincrement())
  design_job_id      Int      @unique
  overall_status_id  Int      @default(2)
  summary            String?  @db.Text
  jurisdiction_notes String?  @db.Text
  reviewed_by        Int?
  reviewed_at        DateTime?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  design_job     design_jobs         @relation(fields: [design_job_id], references: [id], onDelete: Cascade)
  overall_status compliance_statuses @relation(fields: [overall_status_id], references: [id])
  items          compliance_items[]

  @@index([overall_status_id])
}

model compliance_items {
  id                   Int      @id @default(autoincrement())
  compliance_report_id Int
  rule_code            String
  rule_name            String
  status_id            Int      @default(2)
  message              String?  @db.Text
  requires_review      Boolean  @default(false)
  nfpa_reference       String?
  occupancy_rule       Boolean  @default(false)
  metadata             Json?
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  compliance_report compliance_reports  @relation(fields: [compliance_report_id], references: [id], onDelete: Cascade)
  status            compliance_statuses @relation(fields: [status_id], references: [id])

  @@index([compliance_report_id])
  @@index([status_id])
}

// ─────────────────────────────────────────────────────────────────────────────
// MODULE 6 — EXPORT CENTER
// ─────────────────────────────────────────────────────────────────────────────

model exports {
  id            Int       @id @default(autoincrement())
  project_id    Int?
  design_job_id Int?
  user_id       Int
  file_id       Int?
  format_id     Int
  status_id     Int       @default(1)
  title         String?
  error_message String?
  generated_at  DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  user          users           @relation(fields: [user_id], references: [id])
  design_job    design_jobs?    @relation(fields: [design_job_id], references: [id])
  file          files?          @relation(fields: [file_id], references: [id])
  export_format export_formats  @relation(fields: [format_id], references: [id])
  export_status export_statuses @relation(fields: [status_id], references: [id])
  email_shares  export_emails[]

  @@index([user_id])
  @@index([design_job_id])
  @@index([status_id])
}

model export_emails {
  id              Int       @id @default(autoincrement())
  export_id       Int
  sent_by         Int
  recipient_email String
  subject         String?
  message         String?   @db.Text
  sent_at         DateTime?
  status          String    @default("pending")
  created_at      DateTime  @default(now())

  export exports @relation(fields: [export_id], references: [id], onDelete: Cascade)
  sender users   @relation(fields: [sent_by], references: [id])

  @@index([export_id])
}

// ─────────────────────────────────────────────────────────────────────────────
// MODULE 7 — SUBSCRIPTION & BILLING
// ─────────────────────────────────────────────────────────────────────────────

model subscription_plans {
  id                       Int      @id @default(autoincrement())
  name                     String   @unique
  slug                     String   @unique
  description              String?  @db.Text
  price_monthly            Decimal  @db.Decimal(10, 2)
  price_quarterly          Decimal? @db.Decimal(10, 2)
  price_semi_annual        Decimal? @db.Decimal(10, 2)
  price_annual             Decimal? @db.Decimal(10, 2)
  monthly_design_limit     Int?
  features                 Json?
  stripe_price_monthly     String?
  stripe_price_quarterly   String?
  stripe_price_semi_annual String?
  stripe_price_annual      String?
  is_active                Boolean  @default(true)
  sort_order               Int      @default(0)
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt

  subscriptions user_subscriptions[]
}

model user_subscriptions {
  id                     Int       @id @default(autoincrement())
  user_id                Int
  plan_id                Int
  billing_cycle_id       Int       @default(1)
  status_id              Int       @default(1)
  stripe_customer_id     String?
  stripe_subscription_id String?   @unique
  designs_used           Int       @default(0)
  current_period_start   DateTime?
  current_period_end     DateTime?
  cancel_at_period_end   Boolean   @default(false)
  cancelled_at           DateTime?
  trial_ends_at          DateTime?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  user                users                 @relation(fields: [user_id], references: [id])
  plan                subscription_plans    @relation(fields: [plan_id], references: [id])
  billing_cycle       billing_cycles        @relation(fields: [billing_cycle_id], references: [id])
  subscription_status subscription_statuses @relation(fields: [status_id], references: [id])
  invoices            invoices[]

  @@index([user_id])
  @@index([status_id])
}

model usage_events {
  id            Int      @id @default(autoincrement())
  user_id       Int
  project_id    Int?
  design_job_id Int?
  event_type_id Int
  metadata      Json?
  created_at    DateTime @default(now())

  user       users             @relation(fields: [user_id], references: [id])
  project    projects?         @relation(fields: [project_id], references: [id])
  design_job design_jobs?      @relation(fields: [design_job_id], references: [id])
  event_type usage_event_types @relation(fields: [event_type_id], references: [id])

  @@index([user_id])
  @@index([event_type_id])
  @@index([created_at])
}

model invoices {
  id                 Int       @id @default(autoincrement())
  subscription_id    Int
  stripe_invoice_id  String?   @unique
  invoice_number     String?
  amount             Decimal   @db.Decimal(10, 2)
  currency           String    @default("usd")
  status_id          Int       @default(1)
  billing_cycle_id   Int?
  period_start       DateTime?
  period_end         DateTime?
  pdf_url            String?
  hosted_invoice_url String?
  paid_at            DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  subscription    user_subscriptions @relation(fields: [subscription_id], references: [id])
  invoice_status  invoice_statuses   @relation(fields: [status_id], references: [id])
  billing_cycle   billing_cycles?    @relation(fields: [billing_cycle_id], references: [id])

  @@index([subscription_id])
  @@index([status_id])
}

// ─────────────────────────────────────────────────────────────────────────────
// MODULE 8 — SUPPORT CENTER
// ─────────────────────────────────────────────────────────────────────────────

model faq_categories {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  description String?
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  faqs faqs[]
}

model faqs {
  id          Int      @id @default(autoincrement())
  category_id Int
  question    String
  answer      String   @db.Text
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  category faq_categories @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@index([category_id])
}

model help_articles {
  id           Int      @id @default(autoincrement())
  title        String
  slug         String   @unique
  excerpt      String?
  content      String   @db.Text
  category     String?
  is_published Boolean  @default(false)
  sort_order   Int      @default(0)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@index([is_published])
}

model support_tickets {
  id          Int       @id @default(autoincrement())
  user_id     Int
  subject     String
  description String    @db.Text
  status_id   Int       @default(1)
  priority_id Int       @default(2)
  resolved_at DateTime?
  closed_at   DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  user     users             @relation(fields: [user_id], references: [id])
  status   ticket_statuses   @relation(fields: [status_id], references: [id])
  priority ticket_priorities @relation(fields: [priority_id], references: [id])
  replies  ticket_replies[]

  @@index([user_id])
  @@index([status_id])
}

model ticket_replies {
  id         Int      @id @default(autoincrement())
  ticket_id  Int
  user_id    Int
  message    String   @db.Text
  is_staff   Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  ticket support_tickets @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  user   users           @relation(fields: [user_id], references: [id])

  @@index([ticket_id])
}
